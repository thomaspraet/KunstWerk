<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KunstWerk</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KunstWerkWeb.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="background-color:#fff">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-white" style="background-color:#f2f7ec">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="customer" asp-controller="Home" asp-action="Index">
                    <div class="d-flex align-items-center justify-content-center rounded" style="width: 36px; height: 36px; background: rgba(255,255,255,0.2);">
                        <img src="/images/logo.png" style="width: 30px; height: 24px;" />
                    </div>
                    <span class="fw-bold fs-5 d-none d-sm-inline"><span style="color: #515c6a;">Mijn</span> <span style="color: #84b133;">Collectie</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav  me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Copyright">Copyright</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Beheer kunst
                            </a>
                            <ul class="dropdown-menu">
                              <li><a class="dropdown-item" asp-area="" asp-controller="Artists" asp-action="Index">Kunstenaars</a></li>
                              <li><a class="dropdown-item" asp-area="" asp-controller="Technics" asp-action="Index">Technieken</a></li>
                              <li><a class="dropdown-item" href="#">Something else here</a></li>
                            </ul>
        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">

                        
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="flex-grow-1">
        <main role="main">
            
            @RenderBody()
        </main>
    </div>
    <footer class="mt-auto py-4" style="background: #F2F7EC;">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-sm-4 d-flex align-items-center gap-3">
                  
                </div>
                <div class="col-sm-4 text-center">
                    <p <span class="mb-0 fw-semibold small">KunstWerk</span>
                    <span class="mb-0 text-secondary small">&copy; @DateTime.Now.Year</span></p>
                    <p class="mb-0 text-secondary" style="font-size: 0.75rem;">Gemaakt met <i class="bi bi-apple mx-1" style="color: #000;"></i> en met respect voor de kunstenaars en hun werken</p>
                </div>
                
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="//cdn.datatables.net/2.3.7/js/dataTables.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
