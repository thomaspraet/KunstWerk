@using KunstWerk.Models
@model IEnumerable<Technic>

@{
    ViewData["Title"] = "Index";
}

<div class="container px-5 py-4">
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4 d-flex align-items-center justify-content-between" style="background: linear-gradient(to right, #84b133, #515c6a, #dfe057);">
            <div>
                <h5 class="mb-0 fw-bold"><i class="bi bi-grid me-2"></i>Technieken</h5>
                <p class="mb-0 small" style="color: #FFF;">Beheer technieken</p>
            </div>
            <div>
                <a asp-action="Create" class="btn btn-outline-light btn-sm text-right">Maak nieuwe techniek</a>
            </div>
        </div>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>&nbsp;&nbsp;&nbsp;</th>
            <th>&nbsp;&nbsp;</th>
            <th>&nbsp;</th>
            <th>&nbsp;</th>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
            <th></th>
            <th></th>
            <th>
                Acties
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>&nbsp;&nbsp;&nbsp;</td>
                <td>&nbsp;&nbsp;</td>
                <td>&nbsp;&nbsp;</td>
                <td>&nbsp;&nbsp;</td>
                <td>
                    @Html.DisplayFor(model => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Name)
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td>
                    <a class="btn btn-outline-success me-3" asp-action="Edit" asp-route-id="@item.Id">Bewerk</a>
                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Verwijder</a>
                </td>
            </tr>
        }
    </tbody>
</table>
