@model KunstWerk.Models.Tech

@{
    ViewData["Title"] = "Delete";
}

<div class="container-fluid">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Terug naar technieken
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #84b133, #515c6a, #dfe056);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Verwijder techniek</h5>
            <p class="mb-0 small" style="color: #eeeeee;">Verwijder techniek</p>
        </div>
        <div class="card-body p-4">
            <div class="col-md-4">
                <form asp-action="Delete">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="form-group pb-3">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" readonly class="form-control" />
                        
                    </div>
                    
                    <div class="form-group">
                        <input type="submit" value="Verwijder" class="btn btn-outline-danger" /> &nbsp;&nbsp;
                        <a asp-action="Index" class="btn btn-outline-secondary">Terug naar lijst</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>