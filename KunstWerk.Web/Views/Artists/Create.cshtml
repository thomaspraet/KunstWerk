@model KunstWerk.Models.Artist

@{
    ViewData["Title"] = "Create";
}

<div class="container-fluid">
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #84b133, #515c6a, #dfe056);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Maak nieuwe kunstenaar aan</h5>
            <p class="mb-0 small" style="color: #eeeeee;">Voeg een nieuwe kunstenaar toe</p>
        </div>
        <div class="card-body p-4">

            <div class="col-md-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group pb-3">
                        <label asp-for="FirstName" class="control-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group pb-3">
                        <label asp-for="LastName" class="control-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="form-group pb-3">
                        <label asp-for="PlaceOfBirth" class="control-label"></label>
                        <input asp-for="PlaceOfBirth" class="form-control" />
                        <span asp-validation-for="PlaceOfBirth" class="text-danger"></span>
                    </div>

                    <div class="form-group pb-3">
                        <label asp-for="YearOfBirth" class="control-label"></label>
                        <input asp-for="YearOfBirth" class="form-control" />
                        <span asp-validation-for="YearOfBirth" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Maak aan" class="btn btn-outline-success" /> &nbsp;&nbsp;
                        <a asp-action="Index" class="btn btn-outline-secondary">Terug naar lijst</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
